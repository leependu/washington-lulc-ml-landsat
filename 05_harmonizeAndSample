//////////////////                                                                                        //
                                                                                                          //
//// Palette                                                                                              //
var paletteSeason = ee.Dictionary({                                                                       //
  'Spring': 'yellow',                                                                                     //
  'Summer': 'red',                                                                                        //
  'Fall': 'blue',                                                                                         //
  'Winter': 'white'                                                                                       //
});                                                                                                       //
var paletteClass = ee.Dictionary({                                                                        //
  '1': 'cyan',                                                                                            //
  '2': 'teal',                                                                                            //
  '3': 'Olive',                                                                                           //
  '4': 'ForestGreen',                                                                                     //
  '5': 'blue',                                                                                            //
  '7': 'yellow'                                                                                           //
});                                                                                                       //
//// Make image with style                                                                                //
var image = agg_geog415_groundTruth_hrmnzd                                                                //
  .map(function (feature) {                                                                               //
    // Add a style-dictionary property using our chosen palette                                           //
    return feature.set('myStyle', {                                                                       //
      'color': paletteClass.get(feature.get('class')),                                                    //
    });                                                                                                   //
  })                                                                                                      //
  .style({                                                                                                //
    'styleProperty': 'myStyle',                                                                           //
  });                                                                                                     //
// Map                                                                                                    //
Map.setOptions('SATELLITE')                                                                               //
Map.addLayer(image, {}, "Harmonized Training Data");                                                      //
Map.centerObject(agg_geog415_groundTruth_hrmnzd, 7)                                                       //
