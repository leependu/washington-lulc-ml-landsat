var tools = require('users/leependu/washington-lulc-ml-landsat:tools')

//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
                                                                                                                                        //
var agg_geog415_groundTruth_master = ee.FeatureCollection("users/leependu/geog415/u3/agg_geog415_groundTruth_master")                   //
print('Ground truth data:','(agg_geog415_groundTruth_master)',agg_geog415_groundTruth_master.first())                                   //
print('Size of ground truth data:',agg_geog415_groundTruth_master.size())                                                               //
                                                                                                                                        //
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
                                                                                                                  //
function harmoFc (feature) {                                                                                      //
  var id = ee.String(feature.get('id'))                                                                           //
  var cls = ee.Number.parse(feature.get('class'))                                                                 //
  var classDescription = ee.String(feature.get('classDescription'))                                               //
  var date = ee.String(feature.get('date'))                                                                       //
  var path = ee.Number.parse(feature.get('path'))                                                                 //
  var row = ee.Number.parse(feature.get('row'))                                                                   //
  var season = ee.String(feature.get('season'))                                                                   //
  return feature                                                                                                  //
  .set(                                                                                                           //
    'id', id,                                                                                                     //
    'class', cls,                                                                                                 //
    'classDescription', classDescription,                                                                         //
    'date', date,                                                                                                 //
    'path', path,                                                                                                 //
    'row', row,                                                                                                   //
    'season', season                                                                                              //
  )                                                                                                               //
  .select(['id','class','classDescription','date','path','row','season'])                                         //
}                                                                                                                 //
                                                                                                                  //
var agg_geog415_groundTruth_hrmnzd = agg_geog415_groundTruth_master.map(harmoFc)                                  //
print('Harmonized GT data:','(agg_geog415_groundTruth_hrmnzd)',agg_geog415_groundTruth_hrmnzd.first())            //
print('Size of harmonized GT data:',agg_geog415_groundTruth_hrmnzd.size())                                        //
                                                                                                                  //
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

////////////////////////////////////////////////////////////////////////////////////////////////////////////
//          //                                                                                            //
//  JOIN!   //                                                                                            //
//          //                                                                                            //
//////////////                                                                                            //
                                                                                                          //
// Attach each point's source scene: the earliest image within 15 days either side of its date,           //
// at its own path/row (see `tools`)                                                                      //
var agg_geog415_fCiC = tools.joinImage(agg_geog415_groundTruth_hrmnzd);                                   //
                                                                                                          //
print('Feature/Image Collection data:','(agg_geog415_fCiC)', agg_geog415_fCiC.first());                   //
print('Size of F/IC data:',agg_geog415_fCiC.size())                                                       //
                                                                                                          //
////////////////////////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////////////
//          //                                                                                            //
//  SAMPLE  //                                                                                            //
//          //                                                                                            //
//////////////                                                                                            //
                                                                                                          //
// Mask clouds, scale to surface reflectance, and sample at 30 m (see `tools`)                            //
var extr = function(feature) {                                                                            //
  return tools.extrScale(feature, 30);                                                                    //
};                                                                                                        //
// Join reflectance                                                                                       //
var agg_geog415_training = agg_geog415_fCiC.map(extr).flatten();                                          //
print('Training data:','(agg_geog415_training)',agg_geog415_training.first());                            //
print('Size of training data:',agg_geog415_training.size(),"(shrunk by clear mask)");                     //
                                                                                                          //
