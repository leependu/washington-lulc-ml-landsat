////////////////////////////////////////////////////////////////////////////////////////////////////////////
//          //                                                                                            //
//  SAMPLE  //                                                                                            //
//          //                                                                                            //
//////////////                                                                                            //
                                                                                                          //
// Clear pixel mask                                                                                       //
var clrMsk = function(image){                                                                             //
  // Bitmask for clear pixels                                                                             //
  var QABits = 6;                                                                                         //
  // Select the pixel QA band (Different between collections)                                             //
  var clear = image.select('QA_PIXEL')                                                                    //
    // To retrieve all possible values                                                                    //
    .bitwiseAnd(Math.pow(2, QABits))                                                                      //
    // Shift to the first position to retrieve the value                                                  //
    .rightShift(QABits)                                                                                   //
    // Use only pixels that are clear                                                                     //
    .eq(1);                                                                                               //
  return image                                                                                            //
    .select(bands)                                                                                        //
    .updateMask(clear)                                                                                    //
};                                                                                                        //
// Function to convert DN to SR                                                                           //
var dnToSr = function(image) {                                                                            //
  return image                                                                                            //
    .select(bands)                                                                                        //
    .multiply(0.0000275)                                                                                  //
    .add(-0.2)                                                                                            //
}                                                                                                         //
// Bands involved                                                                                         //
var bands = ['SR_B2','SR_B3','SR_B4','SR_B5','SR_B6','SR_B7']                                             //
// Function to extract pixel values and attach to each feature                                            //
var extr = function(feature) {                                                                            //
  var img = ee.Image(feature.get('image'));                                                               //
  // Convert the 'image' property to an image ID string                                                   //
  var imgId = img.id();                                                                                   //
  // Create a new feature with all original properties except 'image' and add 'image_id' instead          //
  var newFeature = ee.Feature(feature.geometry());                                                        //
  // Copy all properties from the original feature                                                        //
  var props = feature.toDictionary();                                                                     //
  // Remove the 'image' property and add 'image_id'                                                       //
  props = props.remove(['image']).set('image_id', imgId);                                                 //
  // Set the properties on the new feature                                                                //
  newFeature = newFeature.set(props);                                                                     //
  // Process the image                                                                                    //
  var imgSr = dnToSr(clrMsk(img).select(bands));                                                          //
  // Sample the image                                                                                     //
  return imgSr.sampleRegions({                                                                            //
    collection: ee.FeatureCollection([newFeature]),                                                       //
    properties: newFeature.propertyNames(),                                                               //
    scale: 30,                                                                                            //
    geometries: true                                                                                      //
  });                                                                                                     //
};                                                                                                        //
// Join reflectance                                                                                       //
var agg_geog415_training = agg_geog415_fCiC.map(extr).flatten();                                          //
print('Training data:','(agg_geog415_training)',agg_geog415_training.first());                            //
print('Size of training data:',agg_geog415_training.size(),"(shrunk by clear mask)");                     //
