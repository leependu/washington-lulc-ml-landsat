  '1': 'cyan',                                                                                            //
  '2': 'teal',                                                                                            //
  '3': 'Olive',                                                                                           //
  '4': 'ForestGreen',                                                                                     //
  '5': 'blue',                                                                                            //
  '7': 'yellow'                                                                                           //
});                                                                                                       //
