var ls8Sr = ee.ImageCollection('LANDSAT/LC08/C02/T1_L2');                                                 //
var ls9Sr = ee.ImageCollection('LANDSAT/LC09/C02/T1_L2');                                                 //
                                                                                                          //
// Function to add time in millisecond since epoch                                                        //
var addMillis = function(feature) {                                                                       //
  var dtMillis = ee.Date(feature.get('date')).millis();                                                   //
  return feature.set('dateMillis', dtMillis);                                                             //
};                                                                                                        //
// Split FC by sensor type                                                                                //
var lsFilters = {                                                                                         //
  'LANDSAT_8': ee.Filter.equals('id', 'LANDSAT_8'),                                                       //
  'LANDSAT_9': ee.Filter.equals('id', 'LANDSAT_9')                                                        //
};                                                                                                        //
var ls8Features = apes.filter(lsFilters['LANDSAT_8']).map(addMillis);                                     //
var ls9Features = apes.filter(lsFilters['LANDSAT_9']).map(addMillis);                                     //
// Process Landsat 8 features by path/row                                                                 //
var processLs8 = function(feature) {                                                                      //
  var path = ee.Number(feature.get('path'));                                                              //
  var row = ee.Number(feature.get('row'));                                                                //
  var date = ee.Date(feature.get('date'));                                                                //
  // Filter to exact path/row                                                                             //
  var filteredImages = ls8Sr                                                                              //
    .filter(ee.Filter.eq('WRS_PATH', path))                                                               //
    .filter(ee.Filter.eq('WRS_ROW', row));                                                                //
  // Take the earliest image within 15 days either side of the point's date (30-day window)               //
  var closestImage = filteredImages                                                                       //
    .filterDate(date.advance(-15, 'day'), date.advance(15, 'day'))                                        //
    .sort('system:time_start', true)                                                                      //
    .first();                                                                                             //
  // Set the image as a property                                                                          //
  return feature.set('image', closestImage);                                                              //
};                                                                                                        //
// Process Landsat 9 features by path/row                                                                 //
var processLs9 = function(feature) {                                                                      //
  var path = ee.Number(feature.get('path'));                                                              //
  var row = ee.Number(feature.get('row'));                                                                //
  var date = ee.Date(feature.get('date'));                                                                //
  // Filter to exact path/row                                                                             //
  var filteredImages = ls9Sr                                                                              //
    .filter(ee.Filter.eq('WRS_PATH', path))                                                               //
    .filter(ee.Filter.eq('WRS_ROW', row));                                                                //
  // Take the earliest image within 15 days either side of the point's date (30-day window)               //
  var closestImage = filteredImages                                                                       //
    .filterDate(date.advance(-15, 'day'), date.advance(15, 'day'))                                        //
    .sort('system:time_start', true)                                                                      //
    .first();                                                                                             //
  // Set the image as a property                                                                          //
  return feature.set('image', closestImage);                                                              //
};                                                                                                        //
// Apply the processing to each feature                                                                   //
var joinLs8 = ls8Features.map(processLs8);                                                                //
var joinLs9 = ls9Features.map(processLs9);                                                                //
// Merge the results                                                                                      //
var apesImage = joinLs8.merge(joinLs9);                                                                   //
                                                                                                          //
print('Row count of dataset w/ joined image: ',apesImage.size())                                          //
print('Dataset w/ joined image (apesImage)', apesImage.limit(10));                                        //
