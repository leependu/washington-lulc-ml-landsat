//// Palette
var paletteSeason = ee.Dictionary({
  'Spring': 'yellow',
  'Summer': 'red',
  'Fall': 'blue',
  'Winter': 'white'
});
var paletteClass = ee.Dictionary({
  '1': 'white',
  '2': 'red',
  '3': 'chartreuse',
  '4': 'green',
  '5': 'blue',
  '7': 'yellow'
});
//// Make image with style
