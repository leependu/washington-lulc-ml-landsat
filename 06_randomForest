// Apply Tasseled Cap if it performed better                                                              //
var finalTrainingComplete = finalUseTC ? finalTrainingAtScale.map(addTasseledCap) : finalTrainingAtScale; //
var finalProperties = finalUseTC ? bandsWithTC : bands;                                                   //
                                                                                                          //
// Split into train/test for final model evaluation                                                       //
var finalTrainTest = finalTrainingComplete.randomColumn();                                                //
var finalTrain = finalTrainTest.filter(ee.Filter.lt('random', 0.8));                                      //
var finalTest = finalTrainTest.filter(ee.Filter.gte('random', 0.8));                                      //
