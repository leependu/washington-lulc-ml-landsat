print('Using variables per split:', finalOptimalVPS);                                                     //
print('Using minimum leaf population:', finalOptimalMinLeaf);                                             //
print('Using bag fraction:', finalOptimalBagFraction);                                                    //
print('Using max nodes:', finalOptimalMaxNodes);                                                          //
print('Final training size:', finalTrain.size());                                                         //
print('Final test size:', finalTest.size());                                                              //
