                                                                                                          //
// Tasseled Cap coefficients for Landsat (moved here for use in scale analysis)                           //
var coefficients = ee.Array([                                                                             //
  [0.3029, 0.2786, 0.4733, 0.5599, 0.508, 0.1872],                                                        //
  [-0.2941, -0.243, -0.5424, 0.7276, 0.0713, -0.1608],                                                    //
  [0.1511, 0.1973, 0.3283, 0.3407, -0.7117, -0.4559],                                                     //
  [-0.8239, 0.0849, 0.4396, -0.058, 0.2013, -0.2773],                                                     //
  [-0.3294, 0.0557, 0.1056, 0.1855, -0.4349, 0.8085],                                                     //
  [0.1079, -0.9023, 0.4119, 0.0575, -0.0259, 0.0252]                                                      //
]);                                                                                                       //
                                                                                                          //
var tcComp = ['brightness', 'greenness', 'wetness', 'fourth', 'fifth', 'sixth'];                          //
                                                                                                          //
// Function to add Tasseled Cap to training data                                                          //
var addTasseledCap = function(feature) {                                                                  //
  var reflectanceArray = ee.Array([                                                                       //
    [ee.Number(feature.get('SR_B2'))],                                                                    //
    [ee.Number(feature.get('SR_B3'))],                                                                    //
    [ee.Number(feature.get('SR_B4'))],                                                                    //
    [ee.Number(feature.get('SR_B5'))],                                                                    //
    [ee.Number(feature.get('SR_B6'))],                                                                    //
    [ee.Number(feature.get('SR_B7'))]                                                                     //
  ]);                                                                                                     //
                                                                                                          //
  var tcArray = coefficients.matrixMultiply(reflectanceArray);                                            //
                                                                                                          //
  return feature                                                                                          //
    .set('brightness', tcArray.get([0, 0]))                                                               //
    .set('greenness', tcArray.get([1, 0]))                                                                //
    .set('wetness', tcArray.get([2, 0]))                                                                  //
    .set('fourth', tcArray.get([3, 0]))                                                                   //
    .set('fifth', tcArray.get([4, 0]))                                                                    //
    .set('sixth', tcArray.get([5, 0]));                                                                   //
};                                                                                                        //
                                                                                                          //
