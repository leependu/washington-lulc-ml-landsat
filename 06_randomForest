// Function to add Tasseled Cap to images (adapted from feature-based function)                           //
var addTasseledCapToImage = function(image) {                                                             //
  var arrayImage1D = image.select(bands).toArray();                                                       //
  var arrayImage2D = arrayImage1D.toArray(1);                                                             //
  var componentsImage = ee.Image(coefficients)                                                            //
    .matrixMultiply(arrayImage2D)                                                                         //
    .arrayProject([0])                                                                                    //
    .arrayFlatten([tcComp]);                                                                              //
  return image.addBands(componentsImage);                                                                 //
};                                                                                                        //
                                                                                                          //
// Function to create composites for change detection                                                     //
var createComposite = function(path, row, startDate, endDate) {                                           //
  var combinedCollection = ls8Sr.merge(ls9Sr)                                                             //
    .filter(ee.Filter.eq('WRS_PATH', path))                                                               //
    .filter(ee.Filter.eq('WRS_ROW', row))                                                                 //
    .filterDate(startDate, endDate)                                                                       //
    .map(function(image) {                                                                                //
      return dnToSr(clrMsk(image));                                                                       //
    });                                                                                                   //
  var composite = combinedCollection.median();                                                            //
  return addTasseledCapToImage(composite);                                                                //
};                                                                                                        //
